# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:4000
# Optional: verification token from Google Search Console (HTML tag method).
GOOGLE_SITE_VERIFICATION=

# Authentication (server-side only)
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
SSO_CLIENT_ID=replace_with_your_skycanvas_client_id
SSO_URL=https://api-sso.skycanvasstudio.com

# Optional. Use this if Playwright browsers are not installed.
# Docker sets this to /usr/bin/chromium.
CHROMIUM_EXECUTABLE_PATH=

# Optional internal PDF renderer. Set both values in production to avoid
# running Chromium in the portfolio container.
PDF_SERVICE_URL=http://html-to-pdf:3000
PDF_SERVICE_SECRET_KEY=replace_with_the_same_internal_pdf_service_key

# Serve file storage (server-side only)
# FILE_SERVER_URL may be the Serve root or API root.
FILE_SERVER_URL=https://files.example.com/api
FILE_SERVER_PUBLIC_URL=https://files.example.com
FILE_SERVER_API_KEY=sk_live_your_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# SMTP (for magic link + any emails)
# Use your provider's SMTP. For Gmail, use an App Password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL=user@example.com
EMAIL_PASSWORD=your_app_password
# Display name shown in recipient inbox (pairs with EMAIL automatically)
EMAIL_FROM=Portfolio
